{
  "name": "awui",
  "version": "0.1.0",
  "private": true,
  "description": "awui: a local, private web UI (and atui, its terminal client) for the Pi, omp, Hermes, and Claude Code coding-agent harnesses",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "awui": "bin/awui",
    "atui": "bin/atui"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.atui.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "build": "vite build && tsc -p tsconfig.server.json",
    "build:binary": "bun run scripts/build-binary.ts",
    "start": "node dist/server/server/index.js",
    "set-password": "node scripts/set-password.mjs",
    "service": "node scripts/service.mjs",
    "smoke": "SMOKE=1 vitest run tests/smoke",
    "atui": "bin/atui",
    "test:atui": "npm run build && bun test tests/atui"
  },
  "dependencies": {
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "solid-js": "1.9.12",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.3.14",
    "@types/express": "5.0.6",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.1.1",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
