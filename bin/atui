#!/bin/sh
# atui: runs src/atui under Bun with OpenTUI's Solid transform, from wherever it is linked.
here=$(dirname "$(readlink -f "$0")")
root=$(dirname "$here")
command -v bun >/dev/null 2>&1 || { echo "atui needs Bun (1.3.14 or later): https://bun.sh" >&2; exit 1; }
exec bun --preload "$root/node_modules/@opentui/solid/scripts/preload.js" "$root/src/atui/main.tsx" "$@"
