#!/bin/sh
# awui: runs the built server (npm run build first) from wherever it is linked.
here=$(dirname "$(readlink -f "$0")")
root=$(dirname "$here")
entry="$root/dist/server/server/index.js"
[ -f "$entry" ] || { echo "awui: not built yet; run npm run build in $root" >&2; exit 1; }
exec node "$entry" "$@"
