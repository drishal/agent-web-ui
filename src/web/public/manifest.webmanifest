{
  "name": "awui",
  "short_name": "awui",
  "description": "Local web UI for the Pi, omp, Hermes, and Claude Code coding agents.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#15161a",
  "theme_color": "#1b1d22",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New chat", "short_name": "New chat", "url": "/?new=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Sessions", "short_name": "Sessions", "url": "/?sessions=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "images", "accept": ["image/png", "image/jpeg", "image/gif", "image/webp"] }]
    }
  }
}
