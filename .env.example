# agent-web-ui settings. Copy to .env (gitignored); the server reads it at startup,
# so restart after editing (systemctl --user restart agent-web-ui).
# Variables already set in the environment win over this file.

# Port for the UI and API (1024-65535).
PORT=4783

# 127.0.0.1: this machine only, no sign-in.
# 0.0.0.0:   also on the LAN (open the port in the firewall); other devices sign in with the login below.
HOST=127.0.0.1

# Login for other devices: needed for HOST=0.0.0.0 or ALLOWED_HOSTS, ignored otherwise.
# This machine never signs in. Password: at least 8 characters; quote it if it has spaces or #.
# Changing it signs every device out. The server keeps it out of the agents' environment.
AUTH_USERNAME=
AUTH_PASSWORD=
